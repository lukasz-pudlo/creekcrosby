# Template for /srv/creekcrosby/.env on the Hetzner VPS (chmod 600, never
# committed). Generate secrets with:  openssl rand -base64 48 | tr -d /=+
# DATABASE_URL must repeat the POSTGRES_PASSWORD value.

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=CHANGE-ME

DJANGO_ALLOWED_HOSTS=creekcrosby.co.uk,www.creekcrosby.co.uk,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://creekcrosby.co.uk,https://www.creekcrosby.co.uk

# Nginx (certbot --redirect) owns the HTTP->HTTPS redirect on this box; the
# in-container healthcheck speaks plain HTTP.
DJANGO_SECURE_SSL_REDIRECT=False

# Portfolio case-study iframe. The inner 'self' quotes are CSP syntax; the
# outer double quotes are for compose's env-file parser, which strips them.
DJANGO_ALLOWED_FRAME_ANCESTORS="'self',https://lukaszpudlo.com,https://www.lukaszpudlo.com"

POSTGRES_DB=creekcrosby
POSTGRES_USER=creekcrosby_user
POSTGRES_PASSWORD=CHANGE-ME
DATABASE_URL=postgres://creekcrosby_user:CHANGE-ME@db:5432/creekcrosby

# Two gunicorn workers is right for a small shared box.
WEB_CONCURRENCY=2

# Contact form email (optional — console-less SMTP; fill in when needed)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@creekcrosby.com
# CONTACT_EMAIL=info@creekcrosby.com

# Later: error tracking / analytics
# SENTRY_DSN=
# REDIS_URL=
